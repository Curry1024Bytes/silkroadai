# ============================================
# LLmRoute Portal — 线上(生产)配置模板
# ============================================
# 用法:在服务器上 cp .env.prod.example .env  然后填入所有 CHANGE_ME。
#        chmod 600 .env(含密钥,锁权限)。
# 这套对应「线上服务器」(docker-compose.prod.yml):
#   - DATABASE_URL 指 compose 内部服务名 portal-postgres(不是 localhost)
#   - new-api 走 host.docker.internal 找宿主机上的 new-api
#   - 域名是你的真实公开域名
# 本地开发配置见 .env.local.example。
#
# ⚠️ NEXT_PUBLIC_ 开头的变量「构建时」编译进产物 —— 改了必须重新
#    docker compose up -d --build,只重启不生效。其余变量运行时读,重启即可。

# --- 数据库 ---
# ⚠️ host 必须是 compose 服务名 portal-postgres,不是 localhost!
#    密码部分要和下面 POSTGRES_PASSWORD 完全一致。
DATABASE_URL="postgresql://portal:CHANGE_ME_DB_PASSWORD@portal-postgres:5432/silkroadai_portal_prod"
# docker-compose.prod.yml 建 PG 容器时用,必须 == DATABASE_URL 里的密码
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"

# --- new-api 后端 ---
# 容器内通过 host.docker.internal 找宿主机上的 new-api(:3000)
# 若 new-api 在别的机器,改成 http://那台机器IP:3000
NEWAPI_BASE_URL="http://host.docker.internal:3000"
# new-api 后台 → 个人设置 → 系统访问令牌 生成
# ⚠️ gotcha #13:生成后别再点「生成」,会 rotate 让旧的失效;人工存档 1Password
NEWAPI_ADMIN_TOKEN="CHANGE_ME"
NEWAPI_ADMIN_USER_ID=1
NEWAPI_QUOTA_PER_USD=500000
USD_TO_CNY_RATE=7.2

# --- Portal 自己的认证 ---
# 各生成一个:openssl rand -hex 32  → 把结果填进来(别直接留 $(...))
PORTAL_JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"
PORTAL_JWT_EXPIRES="7d"
ADMIN_TOKEN="CHANGE_ME_openssl_rand_hex_32"

# 客户自定义 OSS secret 的 AES-256-GCM 加密 key(64 hex = 32 bytes)
# 生成:openssl rand -hex 32
# ⚠️ 一旦投产且有客户存过 OSS 配置,这个 key 就【不可更换】(换了已存 secret 全解不开)
PORTAL_OSS_ENC_KEY="CHANGE_ME_openssl_rand_hex_32"

# --- 公开域名(改成你的真实域名)---
# ⚠️ NEXT_PUBLIC_APP_URL 在 pnpm build 时焊进静态文件(sitemap/robots/og)。
#    改它必须重新 --build。APP_URL 是运行时读(OAuth 回调等),重启生效。
APP_URL="https://llmroute.club"
NEXT_PUBLIC_APP_URL="https://llmroute.club"
NEXT_PUBLIC_SUPPORT_EMAIL="support@llmroute.club"
NEXT_PUBLIC_SUPPORT_WECHAT="Global_Ads"

# Cookie domain:线上用 eTLD+1,保证 OAuth state/session cookie 稳定。
# 本地 localhost 必须留空,见 .env.local.example。
BRAND_COOKIE_DOMAIN=".llmroute.club"

# --- SMTP 邮件(腾讯企业邮箱)---
# 不发验证邮件可暂留 CHANGE_ME,但注册验证/找回密码功能会不可用
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT=465
SMTP_USER="CHANGE_ME_noreply@your-domain.com"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="CHANGE_ME_noreply@your-domain.com"

# --- Google OAuth ---
# Authorized redirect URI 必须 = ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID="609354884573-vp6ccsbv79ltvvg62km0m2a2bddce054.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
GOOGLE_OAUTH_REDIRECT_URI="https://llmroute.club/api/auth/oauth/google/callback"

# --- GitHub OAuth ---
# Authorization callback URL 必须 = ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID="Ov23liVu0O3TY6C1hYpA"
GITHUB_OAUTH_CLIENT_SECRET="CHANGE_ME"
GITHUB_OAUTH_REDIRECT_URI="https://llmroute.club/api/auth/oauth/github/callback"

# --- 易支付 ---
# notify/return URL 必须公网可达(易支付服务器要回调)
PAYMENT_PROVIDERS=easypay
ENABLED_PAYMENT_TYPES=alipay,wxpay
EASY_PAY_PID="2026072211025295"
EASY_PAY_PKEY="CHANGE_ME"
EASY_PAY_API_BASE="https://zpayz.cn"
EASY_PAY_NOTIFY_URL="https://llmroute.club/api/easy-pay/notify"
EASY_PAY_RETURN_URL="https://llmroute.club/pay/result"

# --- 充值规则 ---
ORDER_TIMEOUT_MINUTES=15
MIN_RECHARGE_AMOUNT=10
MAX_RECHARGE_AMOUNT=1000
MAX_DAILY_RECHARGE_AMOUNT=5000
PRODUCT_NAME="LLmRoute 余额充值"

# --- 邀请码(可选)---
INVITE_CODES=""

# --- 默认新用户 Key 配置 ---
DEFAULT_NEW_USER_MAX_BUDGET=0
DEFAULT_NEW_USER_MODELS=""

# --- 端口 ---
APP_PORT=3002

# --- Sentry(可选,留空 = SDK no-op,不报错)---
SENTRY_DSN=

# --- Cloudflare R2 图床(生图功能用;不用生图可留空)---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=silkroadai-image-gen
R2_PUBLIC_URL=https://images.llmroute.club

# --- Chat UI 联网搜索(可选,留空 = 联网开关 no-op)---
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
