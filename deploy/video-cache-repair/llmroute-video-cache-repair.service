[Unit]
Description=Repair verified new-api video cache source redirects
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/llmroute-video-cache-repair/run-video-cache-repair.py --config /etc/llmroute/video-cache-repair.json --apply
TimeoutStartSec=45s
UMask=0077
StateDirectory=llmroute-video-cache-repair
StateDirectoryMode=0700
RuntimeDirectory=llmroute-video-cache-repair
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/llmroute-video-cache-repair
ReadWritePaths=/run/llmroute-video-cache-repair
