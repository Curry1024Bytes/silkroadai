# Copy to /opt/new-api/.env and chmod 600. Never commit the filled-in file.
# Generate each value with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
CRYPTO_SECRET=CHANGE_ME
# After Portal is running, set this to the exact source CIDR seen by new-api.
