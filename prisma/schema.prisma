generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id           String      @id @default(cuid())
  user_id      String?     @db.Uuid
  user         User?       @relation(fields: [user_id], references: [id])
  key_id       String?     @db.Uuid
  userEmail    String?     @map("user_email")
  userName     String?     @map("user_name")
  userNotes    String?     @map("user_notes")
  amount       Decimal     @db.Decimal(10, 2)
  payAmount    Decimal?    @map("pay_amount") @db.Decimal(10, 2)
  feeRate      Decimal?    @map("fee_rate") @db.Decimal(5, 4)
  rechargeCode String      @unique @map("recharge_code")
  status       OrderStatus @default(PENDING)
  paymentType  String      @map("payment_type")

  paymentTradeNo String? @map("payment_trade_no")
  payUrl         String? @map("pay_url")
  qrCode         String? @map("qr_code")
  qrCodeImg      String? @map("qr_code_img")

  refundAmount        Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundReason        String?   @map("refund_reason")
  refundAt            DateTime? @map("refund_at")
  forceRefund         Boolean   @default(false) @map("force_refund")
  refundRequestedAt   DateTime? @map("refund_requested_at")
  refundRequestReason String?   @map("refund_request_reason")
  refundRequestedBy   Int?      @map("refund_requested_by")

  expiresAt    DateTime  @map("expires_at")
  paidAt       DateTime? @map("paid_at")
  completedAt  DateTime? @map("completed_at")
  failedAt     DateTime? @map("failed_at")
  failedReason String?   @map("failed_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  clientIp     String?   @map("client_ip")
  srcHost      String?   @map("src_host")
  srcUrl       String?   @map("src_url")

  // ── 订单类型 & 订阅相关 ──
  orderType           String            @default("balance") @map("order_type")
  planId              String?           @map("plan_id")
  plan                SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptionGroupId Int?              @map("subscription_group_id")
  subscriptionDays    Int?              @map("subscription_days")
  providerInstanceId  String?           @map("provider_instance_id")

  auditLogs AuditLog[]
  recharges RechargeLog[]

  @@index([user_id])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([paidAt])
  @@index([paymentType, paidAt])
  @@index([orderType])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  RECHARGING
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
  REFUND_REQUESTED
  REFUNDING
  PARTIALLY_REFUNDED
  REFUNDED
  REFUND_FAILED
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  action    String
  detail    String?  @db.Text
  operator  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── 渠道展示配置 ──
model Channel {
  id             String   @id @default(cuid())
  groupId        Int?     @unique @map("group_id")
  name           String
  platform       String   @default("claude")
  rateMultiplier Decimal  @map("rate_multiplier") @db.Decimal(10, 4)
  description    String?  @db.Text
  models         String?  @db.Text
  features       String?  @db.Text
  sortOrder      Int      @default(0) @map("sort_order")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("channels")
}

// ── 订阅套餐配置 ──
model SubscriptionPlan {
  id            String   @id @default(cuid())
  groupId       Int?     @map("group_id")
  name          String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(10, 2)
  validityDays  Int      @default(30) @map("validity_days")
  validityUnit  String   @default("day") @map("validity_unit") // day | week | month
  features      String?  @db.Text
  productName   String?  @map("product_name")
  forSale       Boolean  @default(false) @map("for_sale")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([forSale, sortOrder])
  @@map("subscription_plans")
}

// ── 系统配置 ──
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("system_configs")
}

// ── 支付服务商实例（多实例轮询） ──
model PaymentProviderInstance {
  id             String   @id @default(cuid())
  providerKey    String   @map("provider_key") // easypay, alipay, wxpay, stripe
  name           String // display name like "易支付A"
  config         String   @db.Text // encrypted JSON credentials
  supportedTypes String   @default("") @map("supported_types") // comma-separated: alipay,wxpay,stripe
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  limits         String?  @db.Text // JSON per-channel limits: { "alipay": { "dailyLimit": 10000, "singleLimit": 1000 } }
  refundEnabled  Boolean  @default(false) @map("refund_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([providerKey])
  @@index([providerKey, enabled])
  @@map("payment_provider_instances")
}

// ============================================
// Silk Road AI Portal — W1 D2 新增
// ============================================

// ── Portal 自有用户表 ──
model User {
  id                     String     @id @default(uuid()) @db.Uuid
  email                  String     @unique
  password_hash          String
  email_verified         Boolean    @default(false)
  email_verify_token     String?
  email_verify_expires   DateTime?
  reset_password_token   String?
  reset_password_expires DateTime?
  nickname               String?
  avatar_url             String?
  last_login_at          DateTime?
  last_login_ip          String?
  locale                 String     @default("zh-CN") @db.VarChar(10)
  status                 UserStatus @default(active)

  // 关联到 LiteLLM 后端的 user(在 LiteLLM users 表里)
  litellm_user_id String? @unique

  // 关系
  keys      LiteLLMKey[]
  orders    Order[]
  recharges RechargeLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  active
  disabled
  banned
}

// ── LiteLLM Virtual Key ──
model LiteLLMKey {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // LiteLLM 那边的 key(完整 sk-xxx,只在创建时拿到一次)
  litellm_key String @unique
  key_alias   String

  // 当前总额度(= 累计充值)
  max_budget Decimal @default(0) @db.Decimal(12, 4)

  // 缓存的当前 spend(从 LiteLLM 拉)
  cached_spend   Decimal   @default(0) @db.Decimal(12, 4)
  last_synced_at DateTime?

  // 可访问的模型(空数组 = 所有)
  models String[] @default([])

  status KeyStatus @default(active)

  recharges RechargeLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([litellm_key])
  @@map("litellm_keys")
}

enum KeyStatus {
  active
  disabled
  expired
}

// ── 充值流水(审计 + 累计计算)──
model RechargeLog {
  id       String     @id @default(uuid()) @db.Uuid
  user_id  String     @db.Uuid
  user     User       @relation(fields: [user_id], references: [id])
  key_id   String     @db.Uuid
  key      LiteLLMKey @relation(fields: [key_id], references: [id])
  order_id String?
  order    Order?     @relation(fields: [order_id], references: [id])

  amount         Decimal @db.Decimal(12, 4)
  balance_before Decimal @db.Decimal(12, 4)
  balance_after  Decimal @db.Decimal(12, 4)

  // 充值类型
  source RechargeSource @default(payment)
  note   String?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([key_id])
  @@index([order_id])
  @@index([created_at])
  @@map("recharge_logs")
}

enum RechargeSource {
  payment // 支付到账
  manual // 管理员手动充
  refund // 退款(负数)
  promo // 推广奖励
  adjustment // 余额调整
}
