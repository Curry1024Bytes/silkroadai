// ============================================
// 新增 Model 1:Portal 自有用户表
// ============================================
model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique
  password_hash            String
  email_verified           Boolean   @default(false)
  email_verify_token       String?
  email_verify_expires     DateTime?
  reset_password_token     String?
  reset_password_expires   DateTime?
  nickname                 String?
  avatar_url               String?
  last_login_at            DateTime?
  last_login_ip            String?
  locale                   String    @default("zh-CN") @db.VarChar(10)
  status                   UserStatus @default(active)

  // 关联到 LiteLLM 后端的 user(在 LiteLLM users 表里)
  litellm_user_id          String?   @unique

  // 关系
  keys                     LiteLLMKey[]
  orders                   Order[]
  recharges                RechargeLog[]

  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  active
  disabled
  banned
}

// ============================================
// 新增 Model 2:LiteLLM Virtual Key
// ============================================
model LiteLLMKey {
  id                String    @id @default(uuid()) @db.Uuid
  user_id           String    @db.Uuid
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // LiteLLM 那边的 key(完整 sk-xxx,只在创建时拿到一次)
  // 注意:为了安全,这里也可以只存 hash
  litellm_key       String    @unique
  key_alias         String

  // 当前总额度(= 累计充值)
  max_budget        Decimal   @default(0) @db.Decimal(12, 4)

  // 缓存的当前 spend(从 LiteLLM 拉)
  cached_spend      Decimal   @default(0) @db.Decimal(12, 4)
  last_synced_at    DateTime?

  // 可访问的模型(空数组 = 所有)
  models            String[]  @default([])

  status            KeyStatus @default(active)

  recharges         RechargeLog[]

  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([user_id])
  @@index([litellm_key])
  @@map("litellm_keys")
}

enum KeyStatus {
  active
  disabled
  expired
}

// ============================================
// 新增 Model 3:充值流水(审计 + 累计计算)
// ============================================
model RechargeLog {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  user            User      @relation(fields: [user_id], references: [id])
  key_id          String    @db.Uuid
  key             LiteLLMKey @relation(fields: [key_id], references: [id])
  order_id        String?
  order           Order?    @relation(fields: [order_id], references: [id])

  amount          Decimal   @db.Decimal(12, 4)
  balance_before  Decimal   @db.Decimal(12, 4)
  balance_after   Decimal   @db.Decimal(12, 4)

  // 充值类型
  source          RechargeSource @default(payment)
  note            String?

  created_at      DateTime  @default(now())

  @@index([user_id])
  @@index([key_id])
  @@index([order_id])
  @@index([created_at])
  @@map("recharge_logs")
}

enum RechargeSource {
  payment       // 支付到账
  manual        // 管理员手动充
  refund        // 退款(负数)
  promo         // 推广奖励
  adjustment    // 余额调整
}

