# ============================================
# Silk Road AI Portal — 本地开发配置模板
# ============================================
# 用法:cp .env.local.example .env  然后填入下面标 CHANGE_ME 的项。
# 这套对应「本地开发机」:数据库走本地 docker postgres,new-api 走 SSH 隧道。
# 线上配置见 .env.prod.example。两套差异主要是:
#   DATABASE_URL / NEWAPI_BASE_URL / APP_URL / 各 OAuth redirect / 易支付回调
#
# ⚠️ NEXT_PUBLIC_ 开头的变量是「构建时」编译进产物的(改了要重新 pnpm build),
#    其余变量是「运行时」读的(改了重启即可)。详见各项注释。

# --- 数据库 ---
# 本地:docker-compose.dev.yml 起的 postgres,端口 5433(避免和系统 PG 撞)
DATABASE_URL="postgresql://portal:devpass123@localhost:5433/silkroadai_portal_dev"

# --- new-api 后端(B3 路线主链路)---
# 本地走 SSH 隧道转发 VPS 的 :3000:
#   ssh -fN -L 3000:localhost:3000 -o ServerAliveInterval=60 vps
NEWAPI_BASE_URL="http://localhost:3000"
# 在 admin.silkroadai.io 后台 → 个人设置 → 系统访问令牌 生成(31-32 字符)
# ⚠️ gotcha #13:生成后别再点「生成」,会 rotate 让旧的失效
NEWAPI_ADMIN_TOKEN="CHANGE_ME"
NEWAPI_ADMIN_USER_ID=1
# 必须与 new-api QuotaPerUnit 一致;USD 是历史变量名,实际表示技术计费单位。
NEWAPI_QUOTA_PER_USD=500000
# 1 个技术计费单位 = ¥1;真实美元展示单独使用 REAL_USD_TO_CNY_RATE。
USD_TO_CNY_RATE=1
REAL_USD_TO_CNY_RATE=7.2

# --- Portal 自己的认证(本地随便生成,别留 CHANGE_ME)---
# 生成:openssl rand -hex 32  → 把结果填进来
PORTAL_JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"
PORTAL_JWT_EXPIRES="7d"
ADMIN_TOKEN="CHANGE_ME_openssl_rand_hex_32"

# 客户自定义 OSS secret 的 AES-256-GCM 加密 key(64 hex = 32 bytes)
# 生成:openssl rand -hex 32
PORTAL_OSS_ENC_KEY="CHANGE_ME_openssl_rand_hex_32"

# --- 公开域名(本地)---
# ⚠️ NEXT_PUBLIC_APP_URL 构建时焊死,本地无所谓;APP_URL 运行时读
APP_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Cookie domain:本地必须留空(浏览器拒绝给 localhost 设 Domain=)
BRAND_COOKIE_DOMAIN=""

# --- SMTP 邮件(本地可不配,验证邮件发不出但不影响注册)---
# 本地调试可用 EMAIL_DEBUG_LOG=/tmp/mail-debug.log pnpm dev 把链接写文件
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT=465
SMTP_USER="CHANGE_ME_or_leave_for_no_email"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="CHANGE_ME"

# --- Google / GitHub OAuth(本地 redirect 指 localhost:3002)---
# 不调试第三方登录可全留 CHANGE_ME
GOOGLE_OAUTH_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3002/api/auth/oauth/google/callback"
GITHUB_OAUTH_CLIENT_ID="CHANGE_ME"
GITHUB_OAUTH_CLIENT_SECRET="CHANGE_ME"
GITHUB_OAUTH_REDIRECT_URI="http://localhost:3002/api/auth/oauth/github/callback"

# --- 易支付(本地通常不接真实支付,留占位即可)---
PAYMENT_PROVIDERS=easypay
ENABLED_PAYMENT_TYPES=alipay,wxpay
EASY_PAY_PID="CHANGE_ME"
EASY_PAY_PKEY="CHANGE_ME"
EASY_PAY_API_BASE="https://yourepay.com"
EASY_PAY_NOTIFY_URL="http://localhost:3002/api/easy-pay/notify"
EASY_PAY_RETURN_URL="http://localhost:3002/pay/result"

# --- 充值规则 ---
ORDER_TIMEOUT_MINUTES=15
MIN_RECHARGE_AMOUNT=10
MAX_RECHARGE_AMOUNT=1000
MAX_DAILY_RECHARGE_AMOUNT=5000
PRODUCT_NAME="Silk Road AI 余额充值"

# --- 邀请码(可选)---
INVITE_CODES=""

# --- 默认新用户 Key 配置 ---
DEFAULT_NEW_USER_MAX_BUDGET=0
DEFAULT_NEW_USER_MODELS=""

# --- 端口 ---
APP_PORT=3002

# --- 可选服务(本地留空 = 安全 no-op)---
SENTRY_DSN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=silkroadai-image-gen
R2_PUBLIC_URL=
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
