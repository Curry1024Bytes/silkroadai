# ============================================
# LLmRoute Portal — 环境变量
# ============================================

# 数据库
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5432/silkroadai_portal"

# --- new-api 后端(B3 路线主链路)---
# 本地走 SSH 隧道转发 VPS 的 :3000:
#   ssh -fN -L 3000:localhost:3000 -o ServerAliveInterval=60 vps
NEWAPI_BASE_URL="http://localhost:3000"
# 客户 API 公网入口。生产环境指向 Caddy/Cloudflare 分流后的 LLmRoute API。
# 本地通过 portal 自身代理联调时可设为 http://localhost:3002。
NEWAPI_CUSTOMER_BASE_URL="https://api.llmroute.club"
# 在 new-api 管理后台 → 个人设置 → 系统访问令牌 生成(31-32 字符)
NEWAPI_ADMIN_TOKEN="CHANGE_ME"
# admin user 的 int id,默认 root = 1
NEWAPI_ADMIN_USER_ID=1
# mirror：平台分组的名称、用户可选状态、渠道归属和增删全部跟随 new-api。
# 默认分组仍在 Portal 选择；不会改 new-api、价格、已有 Key 或账单。
# 不设置则保留手动登记档次的兼容模式。
NEWAPI_GROUP_SYNC_MODE=
# 必须与 new-api 系统设置 QuotaPerUnit 一致。变量名保留 USD 仅为历史兼容;
# 当前口径是 1 个技术计费单位 = 500_000 raw quota。
# 客户 act-as 凭据的签发方式(开户第 3 步):
#   auto(默认)= 读 GET /api/status 的 version 自动判:rc.41+ 走具名 PAT(nap_…),
#              更老的 rc 走 GET /api/user/token 旧 rotate;
#   pat / legacy = 强制指定(升级到 rc.44 后建议显式写 pat,省掉探测)。
# NEWAPI_ACCESS_TOKEN_MODE=auto
NEWAPI_QUOTA_PER_USD=500000
# 技术计费单位兑人民币。目标口径为 1 个技术计费单位 = ¥1。
USD_TO_CNY_RATE=1
# 真实美元兑人民币汇率,只用于美元展示,不参与客户人民币充值或扣费。
REAL_USD_TO_CNY_RATE=7.2
# (可选)new-api 日志库只读直连 —— admin 客户详情页「导出调用日志 CSV」用。
# 不配置该功能自动关闭(端点返回 503),其余功能不受影响。
# prod 用只读 role(SELECT ON public.logs)+ docker 网络内直连 new-api PostgreSQL:
#   NEWAPI_LOGS_DATABASE_URL="postgresql://portal_logs_ro:<pwd>@postgres:5432/new-api"
# NEWAPI_LOGS_DATABASE_URL=""

# (可选)可靠定价发布的 MySQL 持久化核验，只允许独立账号 SELECT new-api options 表。
# 格式 mysql://newapi_pricing_ro:URL_ENCODED_PASSWORD@MYSQL_HOST:3306/NEWAPI_DATABASE
# 可加 ?ssl=true 启用证书验证；不要使用 root/new-api 写账号，也不要对该库运行 Prisma migration。
# 未配置时明确显示“不可核验”，禁止发布计费价格；其余既有功能照常运行。
NEWAPI_PRICING_DATABASE_URL=""
# 可选：Docker 内网未启用 TLS 时，挂载经核验的 MySQL 服务端 RSA 公钥（绝对路径，PEM）。
# 只读挂载公钥文件，不是私钥；禁止自动向服务器索取公钥。?ssl=true 时优先使用可信 TLS。
NEWAPI_PRICING_RSA_PUBLIC_KEY_FILE=""

# --- P4c 计费总闸(emergency kill-switch)---
# 'portal' = portal ¥账本计费开(还要单客户 User.billing_mode='portal' 才真扣);
# 其它/未设 = 'newapi'(默认):所有人都走 new-api quota 计费(= 现状,零扣费)。
# fail-closed:只有精确 'portal' 才开。炸了一键全回滚 = 删掉此行/设 newapi + 重启。
# BILLING_SOURCE=newapi

# --- LiteLLM 旧后端(W1 路线产物,W2 D5 后已停用)---
# 暂时保留作 fallback / 排查;LITELLM_MASTER_KEY 上线前必须 rotate
# 一旦 W3 D1 在 VPS 关停 LiteLLM 容器,这两行可以删
LITELLM_BASE_URL="http://localhost:4000"
LITELLM_MASTER_KEY="sk-master-CHANGE_ME"

# Portal 自己的认证
PORTAL_JWT_SECRET="CHANGE_ME_$(openssl rand -hex 32)"
PORTAL_JWT_EXPIRES="7d"
ADMIN_TOKEN="CHANGE_ME"      # 管理员后门,bypass JWT

# 客户自定义 OSS(W9 D3)— secret_access_key 的 AES-256-GCM 加密 key
# 64 hex = 32 bytes;生成:openssl rand -hex 32
# ⚠️ 改了这个 key,已存的客户 OSS 凭证全部解不开(客户需重新保存配置)
PORTAL_OSS_ENC_KEY="CHANGE_ME_$(openssl rand -hex 32)"

# ── seedance 大客户独立门户(P1,seedance-enterprise-portal-design.md)──
# PORTAL_FLAVOR=seedance-enterprise → 该实例只服务企业 /v1 视频端点 + admin break-glass,
# 主站页面/API 全 404。主站实例【不要】设这个变量。
# PORTAL_FLAVOR="seedance-enterprise"
# 客户独立上游 key 的 AES-256-GCM 加密 key(64 hex;openssl rand -hex 32)。
# ⚠️ 与 PORTAL_OSS_ENC_KEY 各自独立;投产后不可换(换了已存上游 key 全解不开),进 1Password。
# 主站实例也要配(开户端点在主站/企业实例都可调,加密要同一把 key)。
ENTERPRISE_UPSTREAM_ENC_KEY="CHANGE_ME_$(openssl rand -hex 32)"

# 真人视觉认证「火山」渠道上游(2026-07-29)。客户火山 Action 风格调
# CreateVisualValidateSession/GetVisualValidateResult → 翻译到此 provider 的 REST。
# 平台级共享凭证(非按客户);认证调用不计费。仅企业门户实例需配。
ENTERPRISE_REALPERSON_BASE_URL="http://36.111.35.200:3000"
ENTERPRISE_REALPERSON_KEY="ak-CHANGE_ME"

# 「火山」渠道视频上游(volc region)。2026-08-17 换成筷子 AI 开放平台:火山方舟原生协议
# (/ai-open-platform-api/api/v3/contents/generations/tasks),四档模型
# doubao-seedance-2.0 / -fast / -mini / doubao-seedance-2.5,返回火山直链。
# 平台级共享 key(非按客户)。仅企业实例需配。
# ⚠️ 上游任务 id 为 kz-cgt- 前缀,适配器边界伪装成火山官方 cgt- 形后才对客。
ENTERPRISE_KUAIZI_BASE_URL="https://aiopenapi.kuaizi.cn"
ENTERPRISE_KUAIZI_KEY="kz-CHANGE_ME"

# 筷子自有素材库接管开关(**缺省开**,火山渠道是单客户专属)。volc 渠道客户的素材 Action
# 走筷子私域素材库,与视频面同账号自洽。真人素材(GroupType=LivenessFace)、平台形 id
# (asset-… / group-…)仍回落平台库。cn/global/promax 渠道不受影响。
# ⚠️ 置 "0" 关掉的唯一场景 = 火山渠道接入【第二个客户】:筷子按 ApiKey 账号归属,我们
#    全平台共用一把 key → 多个 volc 客户之间素材互相可见,没有行级隔离。
# ENTERPRISE_KUAIZI_ASSETS="0"

# 【逃生阀】volc 渠道恢复 fast / mini 两档(2026-08-19 下架)。
# 下架原因:实测这两档的 vendor_task_id 返 tsk-…(非火山方舟渠道),而 2.0 / 2.5 返 cgt-…(方舟)。
# 本渠道卖的是「原生火山体验」,这两档的成片不是火山出的 → 先下架。
# 待上游把我们这条线锁死在方舟渠道后,先用本 env 验证 vendor_task_id 回到 cgt-,再删代码里的下架名单。
ENTERPRISE_VOLC_ALLOW_LOW_TIERS=

# 2026-09-11:视频提交改为平台任务号，不再等待或校验 vendor_task_id。
# 旧 ENTERPRISE_VOLC_REQUIRE_ARK 已不生效；不能用此变量保证供应商实际路由。
# 国内版 seedance-2-5 的 480p 单档上游(2026-09-22 起走 service-inference.ai,2026-09-27 起 /v2;与火山渠道同一家、独立 key)。
# 未配 SEEDANCE_SVCINF_KEY → 回落 xinhankr `doubao-seedance-2-5-260628`(缺 env 不断档)。
# 主站 portal + server2 portal-api-1..6(零售 seedance-cn)与企业实例都要配(cn-adapter 两边共用)。
SEEDANCE_SVCINF_KEY="sk-inf-v1-CHANGE_ME"
# SEEDANCE_SVCINF_BASE_URL="https://model.service-inference.ai"
# SEEDANCE_SVCINF_API_VERSION="v2"          # v2 | v1(信封相同;2026-09-27 起缺省 v2,operator 指定)
# SEEDANCE_SVCINF_MODEL_25_480P="doubao-seedance-2-5-260628-max"
# 海外版 proMax 全档上游(2026-10-15 起走 service-inference.ai dreamina-sd-max 线,operator 指定;对客模型/价格不变)。
# 独立 key(与上面两把都不同一把,各线独立计量);未配 → 回落 artsmcp intl 线(缺 env 不断档)。
# 客户 promax 行存了 sk-inf- 真 key 时优先用客户的(任务建在他账号下)。企业实例必配;主站/零售不走 promax 可不配。
# ⚠️ 2026-10-23 起 proMax 已换回 artsmcp intl(key 写在各客户 promax 行,admin upstream-key 端点);本 key 现只用于轮询
#    2026-10-15~10-23 期间建在 service-inference.ai 上的存量 proMax 任务(48h 保留期过后可删)。
SEEDANCE_SVCINF_PROMAX_KEY=""
# SEEDANCE_SVCINF_PROMAX_BASE_URL="https://model.service-inference.ai"
# API 版本:v2(缺省;直传 URL 素材经 preparing 由网关代传 + 支持预传句柄)| v1(直传 URL 直接 pending,不支持句柄)。
# ⚠️ 两版任务互不可见 —— 提交时版本记进 volc_id_map.api_version,轮询按行上的版本打,切 env 不会孤儿化在途任务。
# SEEDANCE_SVCINF_PROMAX_API_VERSION="v2"
# 上游套餐模型名覆盖(以该 key `GET /v1/models` 为准;部分套餐不带 -max 后缀时按档覆盖):
# SEEDANCE_SVCINF_PROMAX_MODEL_PRO="dreamina-seedance-2-0-260128-max"
# SEEDANCE_SVCINF_PROMAX_MODEL_FAST="dreamina-seedance-2-0-fast-260128-max"
# SEEDANCE_SVCINF_PROMAX_MODEL_MINI="dreamina-seedance-2-0-mini-260615-max"
# SEEDANCE_SVCINF_PROMAX_MODEL_25="dreamina-seedance-2-5-260628-max"
# 海外版 global 全档上游(2026-10-17 起同样走 service-inference.ai dreamina-sd-max 线;对客模型/价格不变;480p 随之开放)。
# 又一把独立 key;未配 → 回落 artsmcp intl 线。global fast/mini 的 1080p 档新上游没有,2026-10-19 已下架(artsmcp key 失效)。
SEEDANCE_SVCINF_GLOBAL_KEY=""
# SEEDANCE_SVCINF_GLOBAL_BASE_URL="https://model.service-inference.ai"
# SEEDANCE_SVCINF_GLOBAL_API_VERSION="v2"
# SEEDANCE_SVCINF_GLOBAL_MODEL_PRO="dreamina-seedance-2-0-260128-max"     # 缺省同 proMax 四个套餐名
# SEEDANCE_SVCINF_GLOBAL_MODEL_FAST="dreamina-seedance-2-0-fast-260128-max"
# SEEDANCE_SVCINF_GLOBAL_MODEL_MINI="dreamina-seedance-2-0-mini-260615-max"
# SEEDANCE_SVCINF_GLOBAL_MODEL_25="dreamina-seedance-2-5-260628-max"
# service-inference.ai 提交(火山渠道 + cn 2.5 480p + proMax + global 四条线共用)对上游 500/502/503 的单次退避重试间隔(毫秒)。
# 默认关闭：5xx 不能证明未生成任务，避免重发导致重复收费。显式开启前必须核对渠道幂等契约。
SEEDANCE_SVCINF_SUBMIT_RETRY_MS=0

# volc 素材/组等待供应商编号的上限(毫秒,缺省 60000)。
# 视频提交不再读取此变量；素材适配器仍保留原等待与超时报错语义。
# 只在压测/单测里调小它;生产别动。
# ENTERPRISE_VOLC_VENDOR_WAIT_MS="60000"

# 真人活体检测走哪家(缺省【筷子】)。2026-08-19 并到筷子:此前走 727 provider
# (ENTERPRISE_REALPERSON_*),但那是断链 —— 认证产出的 GroupId 挂在 727 账号里,
# 而 volc 生成早已换成筷子,拿 727 的 group id 去 asset:// 引用筷子不认。
# 置 "727" 切回旧 provider(逃生阀,需同时保留 ENTERPRISE_REALPERSON_* 两项)。
# ENTERPRISE_REALPERSON_PROVIDER="727"

# 企业门户轮询结果缓存 TTL(毫秒,缺省 8000)。客户的轮询频率会 1:1 传导到上游 ——
# 实测 29 个任务在途 × 秒级轮询把上游打到 429。同一 task 在 TTL 内只打一次上游,
# 已完成的结果缓存 60s(不会再变)。⚠️ 进程内缓存,企业实例 3 副本各存各的。
# 置 0 = 整体关闭(逃生阀)。仅企业实例需配。
# ENTERPRISE_POLL_CACHE_MS="8000"

# 企业门户对客展示的 API base URL(docs/概览页示例 endpoint)。服务端运行时读取,
# 缺省 http://128.241.232.23(裸 IP)。上了独立域名后设为 https://<域名>。仅企业实例需配。
ENTERPRISE_BASE_URL="http://128.241.232.23"

# 公开域名(邮件里链接用,reset-password 邮件用 ${NEXT_PUBLIC_APP_URL}/reset-password?token=...)
# 本地开发:http://localhost:3002,生产:https://llmroute.club
#
# Two related vars:
# - APP_URL: plain runtime env, read by server-side OAuth callback for
#   redirect base. Changes take effect on container restart with new env.
# - NEXT_PUBLIC_APP_URL: inlined at `next build` time so SSR + CSR see the
#   same value. Kept as a back-compat fallback. Changing this on a running
#   container has NO effect on server-side reads (must rebuild).
#
# Public values are inlined into browser bundles at build time.
APP_URL="https://llmroute.club"
NEXT_PUBLIC_APP_URL="https://llmroute.club"
NEXT_PUBLIC_API_URL="https://api.llmroute.club"
NEXT_PUBLIC_IMAGE_URL="https://images.llmroute.club"
NEXT_PUBLIC_SUPPORT_EMAIL="support@llmroute.club"
NEXT_PUBLIC_SUPPORT_WECHAT="LLmRoute"

# Cookie domain for cross-subdomain session + OAuth state cookies.
# - Prod: ".llmroute.club" so the apex and API subdomain can share sessions.
# - Local dev: leave empty/unset — browsers refuse Domain= for localhost.
# - Staging: set to your eTLD+1 (e.g. ".staging.llmroute.club").
#
# When unset/empty, cookies are host-scoped (the pre-W7-D3 default).
BRAND_COOKIE_DOMAIN=""

# SMTP 邮件(W3 D4 forgot-password 用,W3 D5 注册验证邮件复用)— 腾讯企业邮箱
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT=465
# 端口 465 = SSL(自动 secure),587 = STARTTLS。getMailer() 按端口判断 secure
SMTP_USER="<企业邮箱地址,例如 noreply@llmroute.club>"
SMTP_PASS="<企业邮箱客户端授权码或密码,1Password 存档>"
SMTP_FROM="<from 地址,通常等于 SMTP_USER>"

# Google OAuth(W3 D6 客户用 Google 一键登录)
# 1) cloud.google.com 创建 OAuth 2.0 Client ID(Web application)
# 2) Authorized redirect URIs 必须 = ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
#    (本地:http://localhost:3002/api/auth/oauth/google/callback)
GOOGLE_OAUTH_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3002/api/auth/oauth/google/callback"

# GitHub OAuth(W3 D7 客户用 GitHub 一键登录)
# 1) github.com/settings/developers 注册 OAuth App(Settings → Developer settings → OAuth Apps → New)
# 2) Authorization callback URL 必须 = ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/github/callback
#    (本地:http://localhost:3002/api/auth/oauth/github/callback)
# 3) GitHub 不支持 PKCE,只用 state CSRF cookie 防重放
GITHUB_OAUTH_CLIENT_ID="CHANGE_ME"
GITHUB_OAUTH_CLIENT_SECRET="CHANGE_ME"
GITHUB_OAUTH_REDIRECT_URI="http://localhost:3002/api/auth/oauth/github/callback"

# 易支付(复用 Sub2ApiPay 已有配置)
PAYMENT_PROVIDERS=easypay
ENABLED_PAYMENT_TYPES=alipay,wxpay
EASY_PAY_PID="CHANGE_ME"
EASY_PAY_PKEY="CHANGE_ME"
EASY_PAY_API_BASE="https://yourepay.com"
EASY_PAY_NOTIFY_URL="https://llmroute.club/api/easy-pay/notify"
EASY_PAY_RETURN_URL="https://llmroute.club/pay/result"

# 充值规则
ORDER_TIMEOUT_MINUTES=15
MIN_RECHARGE_AMOUNT=10
MAX_RECHARGE_AMOUNT=1000
MAX_DAILY_RECHARGE_AMOUNT=5000
PRODUCT_NAME="LLmRoute 余额充值"

# 邀请码(W7 D4)
# 注册时填的可选邀请码,有效码持有人首充 bonus +30%(默认 +20%)。
# 列表逗号或空白分隔,大小写不敏感。空值 / 未设 = 无任何有效邀请码。
# 示例:INVITE_CODES="LAUNCH-A, FRIEND2026, OPS"
# 软撤销:从此列表中移除即可让该码持有者退回默认 bonus 率,无需 DB migration。
INVITE_CODES=""

# 默认新用户的 Key 配置
DEFAULT_NEW_USER_MAX_BUDGET=0          # 新用户默认 0 余额
DEFAULT_NEW_USER_MODELS=""             # 空 = 所有模型,或逗号分隔指定: "claude-opus-4-7,deepseek-v4-flash"

# 端口
APP_PORT=3002

# Sentry(W5 D4 — error reporting,缺值则 SDK 处于 no-op,所有 captureException
# 调用都安全 no-op 不报错。在 sentry.io 注册项目后填进 prod .env 启用)。
SENTRY_DSN=

# Cloudflare R2(PR-T1 image gen — bucket-backed image storage)
# R2_ACCOUNT_ID:Cloudflare account hash(R2 dashboard 顶部)
# R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY:R2 → Manage API Tokens 生成
# R2_BUCKET_NAME:bucket 名(必须先在 R2 dashboard 建好)
# R2_PUBLIC_URL:public-read 访问的 base URL(PR-T2 v2 fix 2026-05-09)
#   ⚠️ 不要用 ${R2_ACCOUNT_ID}.r2.cloudflarestorage.com — 那个 endpoint
#   永远要 SigV4 auth,浏览器 <img src> 会 400。两选一:
#   · 推荐:R2 dashboard → bucket → Settings → Custom Domain bind
#     `images.llmroute.club` → R2_PUBLIC_URL=https://images.llmroute.club
#   · 备选:enable R2.dev subdomain → R2_PUBLIC_URL=https://pub-XXXXX.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=silkroadai-image-gen
R2_PUBLIC_URL=https://images.llmroute.club

# 客户 /v1 请求日志：REQUEST_LOG_STORE=r2 使用独立私有 R2 桶；
# REQUEST_LOG_STORE=local 使用 Docker 私有持久卷 /app/request-logs。
# REQUEST_LOGGING 默认关闭；先配置选定的存储，再设 on。
# 本地卷权限须为 0700 且由容器 UID 1001 拥有；空间不足则跳过日志写入，不影响客户调用。
# 本地原文与 PG 元数据每小时清理超过 REQUEST_LOGGING_RETENTION_DAYS 的记录。
# REQUEST_LOG_LOCAL_MIN_FREE_BYTES 留给数据库/系统的磁盘保留量，默认 8 GiB。
# R2_LOG_BUCKET_NAME 是独立桶名称；推荐使用仅授权该桶的 R2_LOG_* 专属凭据。
# 不配置专属凭据时回退共享 R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY；专属凭据须成对填写。
# R2 模式下，REQUEST_LOGGING_RETENTION_DAYS 控制 PG 到期时间；桶生命周期需设同样天数。
REQUEST_LOG_STORE=r2
REQUEST_LOG_LOCAL_DIR=/app/request-logs
REQUEST_LOG_LOCAL_MIN_FREE_BYTES=8589934592
R2_LOG_BUCKET_NAME=
R2_LOG_ACCESS_KEY_ID=
R2_LOG_SECRET_ACCESS_KEY=
REQUEST_LOGGING=off
REQUEST_LOGGING_SAMPLE_RATE=1
REQUEST_LOGGING_RETENTION_DAYS=7
REQUEST_LOGGING_SKIP_MEDIA=off

# Chat UI v2 — 联网搜索(可选)。不配 TAVILY_API_KEY → /chat 的「联网」开关
# 变 no-op(纯对话照常,getWebSearchProvider() 返 null,runWebSearch 永不 throw)。
# WEB_SEARCH_PROVIDER:默认 tavily(留了 bocha/博查 国产扩展位)
# TAVILY_API_KEY:Tavily 搜索 key;Tavily 免费 1000 次/月、$0.008/次,VPS 可达
# WEB_SEARCH_MAX_RESULTS:1..10,注入给模型的搜索结果条数(默认 5)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Kling 视频透传(2026-08-10):/v1/video/generations 的 kling-* 模型走 portal 直连
# 上游(new-api 无法中继该上游格式,见 src/lib/kling/proxy.ts 文件头)。
# KLING_UPSTREAM_KEY 不配 → kling 提交返回 503(有声报错,其余路径不受影响)。
KLING_UPSTREAM_BASE_URL=https://token.xinhankr.com
KLING_UPSTREAM_KEY=

# MiniMax-H3 视频适配器(2026-08-26):new-api 渠道 base_url 指向 /minimax-adapter,
# 渠道 key = 上游 key(鉴权头原样透传上游,portal 不存 key)。两个变量都可不配:
# MINIMAX_XHK_BASE_URL 缺省 https://token.xinhankr.com;MINIMAX_XHK_KEY 配了则
# 适配器精确校验来访 key(防公网路径被外部直打),不配则只验 sk- 前缀。
MINIMAX_XHK_BASE_URL=
MINIMAX_XHK_KEY=

# OpenAI Batch API 兼容(2026-08-29):/v1/files + /v1/batches,worker 逐行重放
# /v1/images/* 同步管线。全部可不配(括号内为默认值):
# BATCH_MAX_REQUESTS 每批最大行数(1000);BATCH_MAX_INPUT_BYTES 输入 JSONL 上限(20MB);
# BATCH_LINE_CONCURRENCY worker 逐行并发(2,上限 8);
# BATCH_SELF_BASE_URL worker 重放目标(http://127.0.0.1:$APP_PORT,即本实例自己)。
BATCH_MAX_REQUESTS=
BATCH_MAX_INPUT_BYTES=
BATCH_LINE_CONCURRENCY=
BATCH_SELF_BASE_URL=

# LLmRoute: keep Batch disabled until billing-safe crash recovery and credential storage are verified.
PORTAL_BATCH_ENABLED=false

# LLmRoute: enable only after Image 2.5 provider, billing and failure handling are verified.
PORTAL_IMAGE_ADAPTER25_ENABLED=false

# 新增能力保持现有生产策略；显式启用前完成相应验收。
PORTAL_KEY_QUOTA_LIMITS_ENABLED=false
PORTAL_ENTERPRISE_CALLBACK_ENABLED=false
PORTAL_ENTERPRISE_RECONCILE_ENABLED=false
PORTAL_GEMINI_ADAPTER_ENABLED=false

# 保留既有 Seedream Pro 分档阈值；2610000 需单独确认计费策略后选择。
# SEEDREAM_PRO_PIXEL_TIER_THRESHOLD=2360000
